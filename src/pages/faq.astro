---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExampleBanner from '../components/ExampleBanner.astro';

const faqs = [
  {
    q: '¿Este catálogo es contenido real de Hello Menopausia?',
    a: 'Esta primera versión usa contenido de ejemplo basado en videos públicos de YouTube para ilustrar el diseño, las fichas y los embeds. El equipo puede sustituirlo desde Admin.',
  },
  {
    q: '¿Necesito registrarme para ver los cursos?',
    a: 'No. Las 12 sesiones de ejemplo se pueden ver en el sitio. El portal de ponentes y el admin son herramientas internas de esta versión estática.',
  },
  {
    q: '¿Cómo se actualiza un curso?',
    a: 'El equipo entra a /admin con la contraseña de entorno (por defecto hello-admin), edita o agrega cursos y exporta el JSON. Los cambios de esta demo se guardan en el navegador.',
  },
  {
    q: '¿Las ponentes pueden editar su perfil?',
    a: 'Sí. En /ponentes/mi-perfil hay un formulario con validación y el esquema (bio, foto, redes, especialidades) listo para conectar un backend más adelante.',
  },
  {
    q: '¿Dónde veo más de Hello Menopausia?',
    a: 'Visita hellomenopausia.com o escribe a partners@hellomenopausia.com.',
  },
];
---

<BaseLayout
  title="Preguntas frecuentes"
  description="Respuestas sobre el catálogo de cursos y talleres de Hello Menopausia."
>
  <ExampleBanner />
  <section class="page-hero page-hero-plain">
    <div class="container">
      <p class="eyebrow">FAQ</p>
      <h1>Preguntas <em>frecuentes</em></h1>
      <p class="hero-lead">Lo esencial sobre este sitio de cursos y talleres.</p>
    </div>
  </section>
  <section class="section faq" style="padding-top: 0">
    <div class="container narrow">
      <div class="faq-list">
        {
          faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
