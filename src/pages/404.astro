---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="No encontramos esa página.">
  <section class="page-hero page-hero-plain">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>No encontramos esta <em>página</em></h1>
      <p class="hero-lead">Prueba el catálogo de cursos o vuelve al inicio.</p>
      <div class="hero-actions" style="justify-content:center">
        <a class="btn btn-primary" href="/">Ir al inicio</a>
        <a class="btn btn-outline-pill" href="/cursos">Ver cursos</a>
      </div>
    </div>
  </section>
</BaseLayout>
