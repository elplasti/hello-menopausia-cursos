---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import ExampleBanner from '../../components/ExampleBanner.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { getPublishedCourses, speakerInitials, type Course } from '../../lib/content';

export async function getStaticPaths() {
  const courses = await getPublishedCourses();
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course },
  }));
}

interface Props {
  course: Course;
}

const { course } = Astro.props;
const all = await getPublishedCourses();
const related = all.filter((item) => item.id !== course.id).slice(0, 3);
const data = course.data;
---

<BaseLayout title={data.title} description={data.description} canonical={`/cursos/${course.id}`}>
  <ExampleBanner />
  <section class="page-hero">
    <div class="container">
      <p class="crumbs">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/cursos">Cursos</a>
        <span>/</span>
        <span>{data.format}</span>
      </p>
      <p class="eyebrow">{data.category}</p>
      <h1>{data.title}</h1>
      <p class="hero-lead">{data.subtitle}</p>
      <div class="meta-row">
        <span class="tag">{data.format}</span>
        <span class="tag">{data.duration}</span>
        <span class="tag">{data.level}</span>
        {data.example && <span class="tag">Contenido de ejemplo</span>}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container course-layout">
      <div>
        <YouTubeEmbed youtubeId={data.youtubeId} title={data.title} />
        <div class="panel" style="margin-top: 1.5rem">
          <h2 style="margin-top: 0">Sobre esta sesión</h2>
          <p>{data.description}</p>
          <p>
            Video original en
            <a href={data.youtubeUrl} rel="noopener noreferrer" target="_blank">YouTube</a>.
          </p>
        </div>
      </div>
      <aside class="speaker-panel">
        <p class="eyebrow">Ponente</p>
        <div style="display:flex; gap:1rem; align-items:flex-start; margin-bottom:1rem">
          <span class="avatar" aria-hidden="true">{speakerInitials(data.speakerName)}</span>
          <div>
            <h2 style="margin:0 0 0.25rem; font-size:1.2rem">{data.speakerName}</h2>
            <p style="margin:0; color:var(--ink-3)">Ponente invitada</p>
          </div>
        </div>
        <p>Perfil de ejemplo. La ponente podrá completar bio, foto y redes desde su portal.</p>
        <a class="btn btn-block btn-plum" href={`/ponentes/${data.speakerSlug}`}>Ver perfil</a>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section-soft">
        <div class="container">
          <div class="section-head">
            <h2>Más cursos y <em>talleres</em></h2>
          </div>
          <div class="course-grid">
            {related.map((item) => (
              <CourseCard course={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
